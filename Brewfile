# Brewfile for Modern CLI Environment
# Install: brew bundle --file=~/.dotfiles/Brewfile

# Taps
tap "homebrew/bundle"
tap "homebrew/services"

# Shell & Terminal
brew "zsh"              # Modern shell
brew "zsh-completions"  # Additional completion definitions
brew "tmux"             # Terminal multiplexer
brew "starship"         # Cross-shell prompt
brew "sheldon"          # Fast plugin manager for Zsh
brew "direnv"           # Environment switcher

# Modern CLI Tools (Replacements)
brew "eza"              # Modern ls replacement (written in Rust)
brew "bat"              # Cat with syntax highlighting
brew "fd"               # Modern find replacement
brew "ripgrep"          # Fast grep replacement (rg)
brew "fzf"              # Fuzzy finder (peco replacement)
brew "zoxide"           # Smarter cd command (z/enhancd replacement)
brew "git-delta"        # Better git diff viewer

# Git & GitHub
brew "git"              # Version control
brew "gh"               # GitHub CLI (hub replacement)
brew "git-lfs"          # Git Large File Storage

# System Monitoring
brew "btop"             # Modern top replacement

# Development Essentials
brew "neovim"           # Modern vim
brew "tree"             # Directory listing
brew "wget"             # File downloader
brew "curl"             # HTTP client
brew "jq"               # JSON processor
brew "yq"               # YAML processor
brew "ghq"              # Repository management

# Language Version Managers
brew "anyenv"           # Unified environment manager

# Databases
brew "redis"
brew "mysql"
brew "postgresql"

# Build Tools
brew "openssl"
brew "cmake"
brew "gmp"

# Network Tools
brew "telnet"
brew "ssh-copy-id"
brew "mkcert"           # Local HTTPS certificates

# Media & Image Processing
brew "imagemagick"
brew "ffmpeg"

# Programming Languages
brew "python@3.11"
brew "lua"

# Other Utilities
brew "colordiff"        # Colorized diff
